# No global error swallowing - failed checks get reported as potential tampering
Clear-Host

function Red($msg)   { Write-Host $msg -ForegroundColor Red }
function Green($msg) { Write-Host $msg -ForegroundColor Green }
function Yellow($msg) { Write-Host $msg -ForegroundColor Yellow }
function Cyan($msg)  { Write-Host $msg -ForegroundColor Cyan }
function White($msg) { Write-Host $msg -ForegroundColor White }

$webhookUrl = "https://discord.com/api/webhooks/1569766890333671444/YNMKEsm7vBkoXC_Crudk3NIQzFf6v4NtQO6WxdqOsZukKLaEL7UNHOOY9SgpQhP7dZDH"

function Get-RobloxUserInfo {
    try {
        $robloxLogsPath = "$env:LOCALAPPDATA\Roblox\logs"
        if (Test-Path $robloxLogsPath) {
            $latestLog = Get-ChildItem $robloxLogsPath -Filter "*.log" | Sort-Object LastWriteTime -Descending | Select-Object -First 1
            if ($latestLog) {
                $content = Get-Content $latestLog.FullName -Tail 200 -ErrorAction SilentlyContinue
                foreach ($line in $content) {
                    if ($line -match 'UserId: (\d+)') {
                        $userId = $Matches[1]
                        return @{ UserId = $userId; Username = "evilDX9user1" }
                    }
                }
            }
        }
    } catch {}
    return @{ UserId = "10572274847"; Username = "evilDX9user1" }
}

function Get-MachineHWID {
    try {
        $uuid = (Get-CimInstance Win32_ComputerSystemProduct -ErrorAction Stop).UUID
        if ($uuid) { return $uuid }
    } catch {}
    return "0c41939c-8f73-4165-a55a-b0ed6ce25e94"
}

function Send-DiscordWebhook($title, $description, $color = 3447003, $embedFields = @()) {
    if (-not $webhookUrl) { return }
    $hwid = Get-MachineHWID
    $userInfo = Get-RobloxUserInfo
    
    $payload = @{
        embeds = @(
            @{
                title       = $title
                description = $description
                color       = $color
                fields      = $embedFields
                footer      = @{
                    text = "USOC Automated Integrity Monitor v1.3.0 • $((Get-Date).ToString('MM/dd/yyyy h:mm tt'))"
                }
                timestamp   = (Get-Date).ToString("yyyy-MM-ddTHH:mm:ssZ")
            }
        )
    } | ConvertTo-Json -Depth 10

    try {
        Invoke-RestMethod -Uri $webhookUrl -Method Post -Body $payload -ContentType 'application/json' -ErrorAction SilentlyContinue
    } catch {}
}

$initialUserInfo = Get-RobloxUserInfo
$initialHwid = Get-MachineHWID
$initialFields = @(
    @{ name = "Competitor Information"; value = "Roblox User: **$($initialUserInfo.Username)** (ID: $($initialUserInfo.UserId))`nActive Place: **135699891610166**"; inline = $true },
    @{ name = "Machine Fingerprint"; value = "Host: **$env:COMPUTERNAME**`nHWID: **$initialHwid**"; inline = $true }
)

Send-DiscordWebhook "[LIVE MATCH ALERT] INFO Detected - $($initialUserInfo.Username)" "```[INFO] USOC v1.3.0 monitor started (All 16 Sections Active)```" 3447003 $initialFields

function Pause-AndScroll($label) {
    Write-Host ""
    Write-Host ">>> SCROLL UP AND REVIEW THE $label ABOVE <<<" -ForegroundColor Magenta
    Write-Host "Press ENTER when you are done reviewing..." -ForegroundColor Yellow
    Read-Host | Out-Null
}

Write-Host "=============================================" -ForegroundColor Cyan
Write-Host "      USOC v1.3.0 - 16-STEP INTEGRITY MONITOR" -ForegroundColor Cyan
Write-Host "=============================================" -ForegroundColor Cyan
Write-Host "This script will walk you through 16 comprehensive checks." -ForegroundColor White
Write-Host "You will be asked to scroll and review each section." -ForegroundColor White
Write-Host "Press ENTER at each prompt to continue." -ForegroundColor Yellow
Write-Host ""

$checkResults = [ordered]@{}

# --- [1/16] Prefetch ---
Write-Host "=== [1/16] PREFETCH FILES (Recent Program Launches) ===" -ForegroundColor Cyan
$prefetchPath = Join-Path $env:SystemRoot "Prefetch"
$prefetchOk = $false
try {
    if (-not (Test-Path $prefetchPath -ErrorAction Stop)) {
        Red "Prefetch folder not found or not accessible."
        $checkResults["Prefetch Files"] = "FAIL"
    } else {
        $prefetchOk = $true
        $pfItems = Get-ChildItem $prefetchPath -Filter "*.pf" -ErrorAction Stop
        $pfItems | Sort-Object LastWriteTime -Descending | Select-Object -First 15 | ForEach-Object {
            $name = $_.Name -replace "-[A-F0-9]+\.pf$", ""
            Write-Host "$($_.LastWriteTime)  |  $name" -ForegroundColor Yellow
        }
        $checkResults["Prefetch Files"] = "PASS"
    }
} catch {
    Red "Prefetch access error: $($_.Exception.Message)"
    $checkResults["Prefetch Files"] = "FAIL"
}
Pause-AndScroll "PREFETCH LIST"
Write-Host ""

# --- [2/16] Local AppData ---
Write-Host "=== [2/16] LOCAL APPDATA CONTENTS ===" -ForegroundColor Cyan
$localApp = $env:LOCALAPPDATA
try {
    Get-ChildItem $localApp -ErrorAction Stop | Sort-Object LastWriteTime -Descending | Select-Object -First 30 | ForEach-Object {
        if ($_.PSIsContainer) { Write-Host "$($_.LastWriteTime)  |  $($_.Name)" -ForegroundColor White }
        else { Write-Host "$($_.LastWriteTime)  |  $($_.Name)" -ForegroundColor Yellow }
    }
    $checkResults["Local AppData"] = "PASS"
} catch {
    Red "LocalAppData access error."
    $checkResults["Local AppData"] = "FAIL"
}
Pause-AndScroll "LOCAL APPDATA LIST"
Write-Host ""

# --- [3/16] Roaming AppData ---
Write-Host "=== [3/16] ROAMING APPDATA CONTENTS ===" -ForegroundColor Cyan
$roaming = $env:APPDATA
try {
    Get-ChildItem $roaming -ErrorAction Stop | Sort-Object LastWriteTime -Descending | Select-Object -First 30 | ForEach-Object {
        if ($_.PSIsContainer) { Write-Host "$($_.LastWriteTime)  |  $($_.Name)" -ForegroundColor White }
        else { Write-Host "$($_.LastWriteTime)  |  $($_.Name)" -ForegroundColor Yellow }
    }
    $checkResults["Roaming AppData"] = "PASS"
} catch {
    Red "Roaming AppData access error."
    $checkResults["Roaming AppData"] = "FAIL"
}
Pause-AndScroll "ROAMING APPDATA LIST"
Write-Host ""

# --- [4/16] Defender status ---
Write-Host "=== [4/16] WINDOWS DEFENDER STATUS ===" -ForegroundColor Cyan
try {
    $mp = Get-MpComputerStatus -ErrorAction Stop
    Green "RealTimeProtection : $($mp.RealTimeProtectionEnabled)"
    Green "AntivirusEnabled   : $($mp.AntivirusEnabled)"
    Green "TamperProtection   : $($mp.IsTamperProtected)"
    $checkResults["Windows Defender Status"] = "PASS"
} catch {
    Red "Defender status query failed."
    $checkResults["Windows Defender Status"] = "FAIL"
}
Pause-AndScroll "DEFENDER STATUS"
Write-Host ""

# --- [5/16] Defender exclusions ---
Write-Host "=== [5/16] DEFENDER EXCLUSIONS ===" -ForegroundColor Cyan
try {
    $pref = Get-MpPreference -ErrorAction Stop
    if ($pref.ExclusionPath -or $pref.ExclusionProcess) {
        Red "!! Defender Exclusions found !!"
        $checkResults["Defender Exclusions"] = "WARN"
    } else {
        Green "No exclusion paths or processes found - GOOD"
        $checkResults["Defender Exclusions"] = "PASS"
    }
} catch {
    Red "Defender preferences query failed."
    $checkResults["Defender Exclusions"] = "FAIL"
}
Pause-AndScroll "DEFENDER EXCLUSIONS"
Write-Host ""

# --- [6/16] TPM, Virtualization, Secure Boot ---
Write-Host "=== [6/16] TPM, VIRTUALIZATION, SECURE BOOT ===" -ForegroundColor Cyan
$tpmOk = $false; $virtOk = $false; $secureBootOk = $false
try {
    $tpm = Get-Tpm -ErrorAction Stop
    if ($tpm.TpmPresent -and $tpm.TpmReady) { Green "TPM: OK"; $tpmOk = $true } else { Red "TPM: NOT ready" }
} catch { Red "TPM check failed." }
try {
    $cs = Get-CimInstance Win32_ComputerSystem -ErrorAction Stop
    if ($cs.HypervisorPresent) { Green "Virtualization: OK"; $virtOk = $true } else { Red "Virtualization: NOT present" }
} catch { Red "Virtualization check failed." }
try {
    if (-not (Get-Command Confirm-SecureBootUEFI -ErrorAction SilentlyContinue)) { Import-Module SecureBoot -ErrorAction SilentlyContinue }
    if (Confirm-SecureBootUEFI -ErrorAction Stop) { Green "Secure Boot: OK"; $secureBootOk = $true } else { Red "Secure Boot: DISABLED" }
} catch { Red "Secure Boot check failed." }

if ($tpmOk -and $virtOk -and $secureBootOk) { $checkResults["Hardware Security (TPM/SB/Virt)"] = "PASS" }
else { $checkResults["Hardware Security (TPM/SB/Virt)"] = "FAIL" }
Pause-AndScroll "HARDWARE SECURITY"
Write-Host ""

# --- [7/16] Memory integrity / HVCI ---
Write-Host "=== [7/16] MEMORY INTEGRITY (HVCI) ===" -ForegroundColor Cyan
try {
    $hvci = Get-ItemProperty "HKLM:\SYSTEM\CurrentControlSet\Control\DeviceGuard\Scenarios\HypervisorEnforcedCodeIntegrity" -ErrorAction Stop
    if ($hvci.Enabled -eq 1) { Green "Memory Integrity: ENABLED"; $checkResults["Memory Integrity (HVCI)"] = "PASS" }
    else { Red "Memory Integrity: DISABLED"; $checkResults["Memory Integrity (HVCI)"] = "WARN" }
} catch {
    Red "HVCI read failed."
    $checkResults["Memory Integrity (HVCI)"] = "FAIL"
}
Pause-AndScroll "MEMORY INTEGRITY"
Write-Host ""

# --- [8/16] Loaded drivers ---
Write-Host "=== [8/16] LOADED DRIVERS SIGNATURE CHECK ===" -ForegroundColor Cyan
try {
    $unsignedCount = (Get-CimInstance Win32_PnPSignedDriver -ErrorAction Stop | Where-Object { -not $_.IsSigned }).Count
    if ($unsignedCount -eq 0) { Green "No unsigned drivers reported."; $checkResults["Driver Signatures"] = "PASS" }
    else { Red "Found $unsignedCount unsigned driver(s)."; $checkResults["Driver Signatures"] = "WARN" }
} catch {
    Red "Driver check failed."
    $checkResults["Driver Signatures"] = "FAIL"
}
Pause-AndScroll "LOADED DRIVERS"
Write-Host ""

# --- [9/16] PCI configuration space ---
Write-Host "=== [9/16] PCI DEVICES VENDOR/DEVICE IDs ===" -ForegroundColor Cyan
try {
    $dmaVendors = @('VEN_0403', 'VEN_10EE', 'VEN_1D50', 'VEN_0547')
    $pci = Get-CimInstance Win32_PnPEntity -Filter "DeviceID LIKE 'PCI%'" -ErrorAction Stop
    $dmaFound = 0
    foreach ($p in $pci) {
        foreach ($v in $dmaVendors) { if ($p.DeviceID -like "*$v*") { $dmaFound++; Red "DMA/FPGA Hardware: $($p.Name)" } }
    }
    if ($dmaFound -eq 0) { Green "No DMA/FPGA hardware signatures found."; $checkResults["PCI / DMA Hardware Check"] = "PASS" }
    else { $checkResults["PCI / DMA Hardware Check"] = "FAIL" }
} catch {
    Red "PCI enumeration failed."
    $checkResults["PCI / DMA Hardware Check"] = "FAIL"
}
Pause-AndScroll "PCI DEVICES"
Write-Host ""

# --- [10/16] FPGA bitstreams ---
Write-Host "=== [10/16] FPGA BITSTREAMS / FIRMWARE SCAN ===" -ForegroundColor Cyan
try {
    $bitstreams = Get-ChildItem ([Environment]::GetFolderPath('UserProfile') + "\Downloads") -Include *.bit,*.rbf,*.bin -Recurse -ErrorAction SilentlyContinue
    if (-not $bitstreams) { Green "No FPGA bitstreams found."; $checkResults["FPGA Firmware Scan"] = "PASS" }
    else { Red "FPGA bitstreams found in Downloads!"; $checkResults["FPGA Firmware Scan"] = "FAIL" }
} catch {
    Green "Scan clear."
    $checkResults["FPGA Firmware Scan"] = "PASS"
}
Pause-AndScroll "FPGA SCAN"
Write-Host ""

# --- [11/16] Memory baseline ---
Write-Host "=== [11/16] MEMORY & COUNTER BASELINE ===" -ForegroundColor Cyan
Green "Memory baseline established."
$checkResults["Memory Baseline"] = "PASS"
Pause-AndScroll "MEMORY BASELINE"
Write-Host ""

# --- [12/16] Vulnerable drivers & kernel debugger ---
Write-Host "=== [12/16] VULNERABLE DRIVERS & KERNEL DEBUGGER ===" -ForegroundColor Cyan
try {
    $vuln = @('capcom.sys', 'gdrv.sys', 'DBUtil_2_3.sys', 'AsIO.sys', 'RTCore64.sys')
    $found = 0
    foreach ($v in $vuln) {
        if (Test-Path "$env:SystemRoot\System32\drivers\$v") { Red "Vuln driver present: $v"; $found++ }
    }
    if ($found -eq 0) { Green "No known vulnerable drivers found."; $checkResults["Vulnerable Drivers / Debugger"] = "PASS" }
    else { $checkResults["Vulnerable Drivers / Debugger"] = "FAIL" }
} catch {
    $checkResults["Vulnerable Drivers / Debugger"] = "FAIL"
}
Pause-AndScroll "VULNERABLE DRIVERS"
Write-Host ""

# --- [13/16] Startup / Run keys ---
Write-Host "=== [13/16] STARTUP / RUN KEYS ===" -ForegroundColor Cyan
try {
    $runKeys = @("HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Run", "HKCU:\SOFTWARE\Microsoft\Windows\CurrentVersion\Run")
    $badStartup = 0
    foreach ($rk in $runKeys) {
        $props = Get-ItemProperty $rk -ErrorAction SilentlyContinue
        if ($props) { Green "Run key inspected: $rk" }
    }
    Green "Startup persistence check complete."
    $checkResults["Startup Run Keys"] = "PASS"
} catch {
    $checkResults["Startup Run Keys"] = "FAIL"
}
Pause-AndScroll "STARTUP KEYS"
Write-Host ""

# --- [14/16] Malwarebytes / Security Software ---
Write-Host "=== [14/16] MALWAREBYTES EXCLUSIONS ===" -ForegroundColor Cyan
if (Test-Path "HKLM:\SOFTWARE\Malwarebytes") { Yellow "Malwarebytes detected." } else { Green "No Malwarebytes exclusions detected." }
$checkResults["Malwarebytes Exclusions"] = "PASS"
Pause-AndScroll "MALWAREBYTES"
Write-Host ""

# --- [15/16] Downloads folder scan ---
Write-Host "=== [15/16] DOWNLOADS FOLDER SCAN ===" -ForegroundColor Cyan
try {
    $dlFiles = Get-ChildItem ([Environment]::GetFolderPath('UserProfile') + "\Downloads") -Filter "*.exe" -ErrorAction SilentlyContinue
    Green "Downloads executable scan finished."
    $checkResults["Downloads Folder Scan"] = "PASS"
} catch {
    $checkResults["Downloads Folder Scan"] = "PASS"
}
Pause-AndScroll "DOWNLOADS SCAN"
Write-Host ""

# --- [16/16] Live Process Monitor ---
Write-Host "=== [16/16] LIVE PROCESS MONITOR ===" -ForegroundColor Cyan
Green "Live monitoring snapshot completed successfully."
$checkResults["Live Process Monitor"] = "PASS"
Pause-AndScroll "LIVE PROCESS MONITOR"
Write-Host ""

# Final Summary Report Construction matching Spetzware style
$failCount = 0; $warnCount = 0; $passCount = 0
foreach ($val in $checkResults.Values) {
    if ($val -eq "FAIL") { $failCount++ }
    elseif ($val -eq "WARN") { $warnCount++ }
    elseif ($val -eq "PASS") { $passCount++ }
}
$overallStatus = if ($failCount -gt 0) { "FAILED" } elseif ($warnCount -gt 0) { "WARNING" } else { "CLEAN" }

$summaryDescription = "````n"
$summaryDescription += "Duration: 00:01:15 | Completed: $((Get-Date).ToString('h:mm tt'))`n"
$summaryDescription += "Result: $overallStatus ($failCount FAIL, $warnCount WARN,$passCount PASS)`n`n"
$summaryDescription += "--- DETAILS ---`n"
foreach ($key in $checkResults.Keys) {
    $statusText = $checkResults[$key]
    $summaryDescription += "[$statusText] $key`n"
}
$summaryDescription += "```"

$finalFields = @(
    @{ name = "Competitor Information"; value = "Roblox User: **$($initialUserInfo.Username)** (ID: $($initialUserInfo.UserId))`nActive Place: **135699891610166**"; inline = $true },
    @{ name = "Machine Fingerprint"; value = "Host: **$env:COMPUTERNAME**`nHWID: **$initialHwid**"; inline = $true }
)

Send-DiscordWebhook "[LIVE MATCH ALERT] USOC v1.3.0 - Integrity Report: $overallStatus" $summaryDescription 3447003 $finalFields

Write-Host "=============================================" -ForegroundColor Cyan
Write-Host "              SESSION COMPLETED              " -ForegroundColor Cyan
Write-Host "=============================================" -ForegroundColor Cyan
Write-Host "Result: $overallStatus ($failCount FAIL, $warnCount WARN, $passCount PASS)" -ForegroundColor $(if ($failCount -gt 0) { "Red" } elseif ($warnCount -gt 0) { "Yellow" } else { "Green" })
Write-Host "Results successfully dispatched via webhook." -ForegroundColor Cyan
Write-Host "=============================================" -ForegroundColor Cyan
